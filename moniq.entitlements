<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required: read hardware info via mach host APIs -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Required for full system monitoring outside sandbox -->
    <!-- NOTE: For App Store submission, use the sandboxed version
         with only specific entitlements that Apple approves.
         For direct distribution, sandbox = false gives full access. -->

    <key>com.apple.security.network.client</key>
    <true/>

    <key>com.apple.security.network.server</key>
    <false/>

    <!-- Required: ServiceManagement for launch-at-login -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array>
        <string>com.apple.launchservicesd</string>
    </array>
</dict>
</plist>
